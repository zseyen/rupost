# 调试演示套件：订单系统 API（配合 mock_backend.json 使用）
# 用法：rupost t suite.http --var base_url=http://127.0.0.1:9500 --var password=hunter2

### 用户登录（@capture 提取 token 供下游使用）
# @name login
# @capture token from body.token
POST {{base_url}}/api/auth/login
Content-Type: application/json

{
    "username": "lee",
    "password": "{{password}}"
}

### 用户资料（依赖上游捕获的 token；mock 校验 Authorization 头）
# @name profile
# @assert status == 200
GET {{base_url}}/api/user/profile
Authorization: Bearer {{token}}

### 订单列表（应答 200）
# @name orders
# @assert status == 200
GET {{base_url}}/api/orders

### 报表导出（mock 固定应答 500 —— 模拟服务端故障，供分诊/取证演示）
# @name report
# @assert status == 200
GET {{base_url}}/api/report/export

### 账户配额（mock 应答 quota=100，断言故意写 999 —— 模拟契约断言失败）
# @name billing
# @assert body.quota == 999
GET {{base_url}}/api/billing
