# RuPost 大模型 (LLM) 环境变量配置模板
# 使用说明：将此文件重命名为 `.env` 并填写您的配置，RuPost 运行时会自动在同级目录加载。

# 大模型接口的通用配置
# 1. 本地大模型联调（Ollama 默认地址为 http://localhost:11434/v1）
# 2. 云端大模型 API（如 DeepSeek：https://api.deepseek.com/v1）
BASE_URL=https://api.deepseek.com/v1

# 您的云端大模型 API 密钥（Authorization: Bearer {{env.API_KEY}}）
API_KEY=sk-your-real-api-key-here

# 默认的模型名称。您也可以直接在 HTTP 请求体 JSON 中硬编码指定具体模型，以覆盖此全局变量
MODEL_NAME=deepseek-chat

# 网关中转代理所需的 Relay Token（如有需要）
RELAY_TOKEN=your-relay-token-here
