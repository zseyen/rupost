# RuPost 大模型与 SSE 示例环境变量配置
# 使用说明：将此文件复制到本目录下并重命名为 `.env`。
# 
# ⚠️ 重要 (URL 智能自适应拼接规则)：
# 本示例对应的测试用例文件（如 llm_demo.md / llm_demo.http 等）中已经声明了文件级的总体路径：
#   base_path: /v1/chat/completions (或在 HTTP 中声明为 # @base_path /v1/chat/completions)
# 
# 当运行相对路径测试时（如用例中写 POST /），RuPost 会按如下公式自动拼接：
#   最终 URL = BASE_URL (去尾斜杠) + base_path (去首尾斜杠) + 用例路径 (去首斜杠)
# 
# 为了避免路径中重复出现版本号导致 404（例如出现 /v1/v1/chat/completions），
# 您的 BASE_URL 应当只配置到域名/网关基本路径，不应当包含 "/v1" 后缀。

# 云端真实接口测试配置（DashScope 兼容接口）
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
API_KEY=sk-ws-H.RYMIIEP.59j4.MEUCIQCjv3Fsf7LGEHhPuGMTjAj53J8zNwaCqCsJ6dXBTYu0MwIgOfXkA3nKXDfnnXwiTUk615OAuzKQYfXy-IYdzLzOQYY

# 默认的模型名称
MODEL_NAME=qwen3.6-flash

# 网关中转代理所需的 Relay Token
RELAY_TOKEN=mock-relay-token
