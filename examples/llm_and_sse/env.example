# RuPost 大模型与 SSE 示例环境变量配置
# 使用说明：将此文件复制到根目录下并重命名为 `.env`

# 1. 本地 Mock 闭环仿真（推荐）
BASE_URL=http://127.0.0.1:8080/v1

# 2. 云端真实接口测试（取消注释并填写您的真实 API_KEY）
# BASE_URL=https://api.deepseek.com/v1
# API_KEY=sk-your-real-api-key-here

# 默认的模型名称
MODEL_NAME=deepseek-chat

# 网关中转代理所需的 Relay Token
RELAY_TOKEN=mock-relay-token
